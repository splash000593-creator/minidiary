<view class="page-pad"><view class="intro"><view class="title">一步一步，成为想成为的自己</view><view class="sub">今天，也为自己打一个卡吧</view></view><view class="date-filter"><picker mode="date" value="{{viewDate}}" bindchange="chooseDate"><view class="date-filter-btn">📅 {{viewLabel}} ›</view></picker><view wx:if="{{viewDate !== today}}" class="date-filter-clear" bindtap="backToday">回到今天</view></view><view wx:if="{{goals.length}}"><view class="goal-card {{item.checked ? 'is-checked' : ''}}" wx:for="{{goals}}" wx:key="_id"><view class="goal-main" data-id="{{item._id}}" bindtap="editGoal"><view class="goal-icon">{{item.icon || '🎯'}}</view><view class="goal-body"><view class="goal-title">{{item.title}}</view><view class="goal-desc" wx:if="{{item.type === 'habit'}}">今日目标</view><view class="goal-desc" wx:else>进度 {{item.currentValue || 0}} / {{item.targetValue}} {{item.unit}}</view><view wx:if="{{item.type === 'once'}}" class="progress"><view class="progress-inner" style="width: {{item.progressPct}}%"></view></view></view></view><view wx:if="{{item.type === 'habit'}}" class="check {{item.checked ? 'checked' : ''}}" data-id="{{item._id}}" bindtap="toggleCheckin">{{item.checked ? '✓' : ''}}</view></view></view><view wx:else class="empty large-empty">还没有今日目标，添加一个吧～</view><view class="fab" bindtap="addGoal">＋</view></view>
