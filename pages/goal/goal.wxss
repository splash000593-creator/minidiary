.intro{position:relative;padding:60rpx 34rpx 22rpx}.intro::before{content:"LITTLE VOWS";display:block;margin-bottom:6rpx;color:#a25466;font:20rpx Georgia,serif;letter-spacing:6rpx}.intro::after{content:"✦  ☾";position:absolute;right:36rpx;top:45rpx;color:#813147;font:27rpx Georgia,serif;letter-spacing:7rpx}.title{color:#3b1625;font:700 39rpx Georgia,"Songti SC",serif;letter-spacing:1rpx}.sub{margin-top:8rpx;color:#9c8182;font-size:24rpx}.goal-card{display:flex;align-items:center;margin:22rpx 24rpx;padding:28rpx;background:rgba(255,251,247,.93);border:1rpx solid #e5d1cc;border-radius:29rpx 29rpx 18rpx 18rpx;box-shadow:0 13rpx 29rpx rgba(53,20,31,.06)}.goal-main{display:flex;align-items:center;min-width:0;flex:1}.goal-icon{width:76rpx;height:76rpx;margin-right:20rpx;color:#813147;background:#f7e9e6;border:1rpx solid #ebd8d3;border-radius:50%;font-size:39rpx;line-height:76rpx;text-align:center}.goal-body{min-width:0;flex:1}.goal-title{overflow:hidden;color:#43212a;font:700 30rpx Georgia,"Songti SC",serif;text-overflow:ellipsis;white-space:nowrap}.goal-desc{margin-top:4rpx;color:#9c8584;font-size:23rpx}.progress{height:12rpx;overflow:hidden;margin-top:12rpx;background:#f0e1dd;border-radius:10rpx}.progress-inner{height:100%;background:linear-gradient(90deg,#76233c,#c17078);border-radius:10rpx}.check{width:55rpx;height:55rpx;color:#fff;border:2rpx solid #c9a8aa;border-radius:50%;font:34rpx/51rpx Georgia,serif;text-align:center}.check.checked{border-color:#793047;background:#793047;box-shadow:0 5rpx 10rpx rgba(101,31,53,.19)}.large-empty{padding-top:180rpx}.fab{position:fixed;right:36rpx;bottom:64rpx;width:108rpx;height:108rpx;color:#fff;background:linear-gradient(135deg,#54172a,#a64058);border:4rpx solid #f7e9e3;border-radius:50%;box-shadow:0 10rpx 26rpx rgba(81,20,39,.32);font:52rpx/99rpx Georgia,serif;text-align:center}

.goal-card.is-checked .goal-icon,.goal-card.is-checked .goal-title,.goal-card.is-checked .goal-desc{color:#b3a3a3}