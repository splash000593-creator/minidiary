<view class="page-pad">
  <view class="month-bar"><view class="month-nav" bindtap="prevMonth">‹</view><view class="month-label">{{monthLabel}}</view><view class="month-nav" bindtap="nextMonth">›</view></view>
  <view class="card summary"><view class="sum-item"><view class="sum-num amount-expense">-{{expense}}</view><view class="sum-label">支出</view></view><view class="sum-item"><view class="sum-num amount-income">+{{income}}</view><view class="sum-label">收入</view></view><view class="sum-item"><view class="sum-num">{{balance}}</view><view class="sum-label">结余</view></view></view>
  <view class="card" wx:if="{{budget}}"><view class="card-title"><text>本月预算</text><text class="budget-edit" bindtap="toggleBudgetEdit">{{editingBudget ? '完成' : '修改'}}</text></view><view wx:if="{{!editingBudget}}"><view class="budget-bar"><view class="budget-bar-inner {{budgetOver ? 'budget-bar-over' : (budgetUsedPct > 80 ? 'budget-bar-warn' : '')}}" style="width: {{budgetUsedPct}}%"></view></view><view class="budget-info"><text>已用 {{budgetUsed}}</text><text>预算 {{budgetAmount}}</text></view><view wx:if="{{budgetOver}}" class="budget-tip">⚠️ 已超出预算</view><view wx:elif="{{budgetUsedPct > 80}}" class="budget-tip">注意：预算已使用 {{budgetUsedPct}}%</view></view><view wx:else class="budget-input-row"><input class="budget-input" type="digit" placeholder="输入预算金额" value="{{budgetInput}}" bindinput="onBudgetInput"/><button class="btn btn-primary budget-save" bindtap="saveBudget">保存</button></view></view>
  <view class="card" wx:else><view class="card-title"><text>预算</text><text class="budget-edit" bindtap="toggleBudgetEdit">{{editingBudget ? '取消' : '设置'}}</text></view><view wx:if="{{editingBudget}}" class="budget-input-row"><input class="budget-input" type="digit" placeholder="输入预算金额" value="{{budgetInput}}" bindinput="onBudgetInput"/><button class="btn btn-primary budget-save" bindtap="saveBudget">保存</button></view><view wx:else class="empty">还没有设置预算</view></view>
  <view class="card" wx:if="{{categories.length}}"><view class="card-title">支出分类</view><view class="cat-item" wx:for="{{categories}}" wx:key="name"><view class="cat-head"><text>{{item.icon}} {{item.name}}</text><text>-{{item.amountText}}</text></view><view class="cat-bar"><view class="cat-bar-inner" style="width: {{item.pct}}%; background: {{item.color}}"></view></view><view class="cat-pct">{{item.pct}}%</view></view></view>
  <view class="card" wx:if="{{allGrouped.length}}"><view class="card-title">明细</view><view class="detail-filter"><picker mode="date" value="{{detailDate}}" end="{{monthEnd}}" bindchange="chooseDetailDate"><view class="detail-filter-btn">{{detailDate || '选择日期查看当天明细'}} ›</view></picker><view wx:if="{{detailDate}}" class="detail-filter-clear" bindtap="clearDetailDate">查看全部</view></view><block wx:if="{{grouped.length}}"><block wx:for="{{grouped}}" wx:for-item="day" wx:key="date"><view class="day-head"><text>{{day.label}}</text><text>支 {{day.expenseText}} · 收 {{day.incomeText}} · 结 {{day.balanceText}}</text></view><view class="item" wx:for="{{day.items}}" wx:for-item="it" wx:key="_id" bindtap="editItem" data-id="{{it._id}}"><view class="item-icon">{{it.icon}}</view><view class="item-body"><view class="item-title">{{it.category}}<text wx:if="{{it.note}}"> · {{it.note}}</text></view><view class="item-time">{{it.time}}</view></view><view class="item-amount {{it.type === 'income' ? 'amount-income' : 'amount-expense'}}">{{it.type === 'income' ? '+' : '-'}}{{it.amountText}}</view></view></block></block><view wx:else class="empty">这一天没有记录</view></view>
  <view class="card" wx:else><view class="empty">本月还没有记录</view></view>
  <view class="fab" bindtap="addItem">＋</view>
</view>
