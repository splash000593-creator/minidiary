.month-bar { display:flex; align-items:center; justify-content:space-between; padding:34rpx 42rpx 4rpx; }
.month-nav { width:66rpx; height:66rpx; color:#72283e; font:45rpx/61rpx Georgia, serif; text-align:center; background:#fffaf5; border:1rpx solid #d7b8b9; border-radius:50%; box-shadow:0 7rpx 15rpx rgba(68,20,34,.08); }
.month-label { position:relative; color:#3b1725; font:700 36rpx Georgia, "Songti SC", serif; letter-spacing:2rpx; }
.month-label::before,.month-label::after { color:#a95165; font-size:22rpx; }
.month-label::before { content:"✦ "; }.month-label::after { content:" ✦"; }
.summary { display:flex; padding-top:34rpx; padding-bottom:34rpx; background:linear-gradient(130deg,#fffaf6,#f8e9e7); }
.sum-item { position:relative; flex:1; text-align:center; }.sum-item:not(:last-child)::after{content:"";position:absolute;right:0;top:13rpx;width:1rpx;height:62rpx;background:#ead7d2}.sum-num{color:#3a2229;font:700 37rpx Georgia,serif}.sum-label{margin-top:6rpx;color:#a58d8a;font-size:22rpx;letter-spacing:2rpx}.budget-edit{color:#8c3148;font-size:24rpx;font-family:Georgia,serif}.budget-bar,.cat-bar{height:14rpx;overflow:hidden;background:#f0e3df;border-radius:16rpx}.budget-bar-inner,.cat-bar-inner{height:100%;border-radius:16rpx;background:linear-gradient(90deg,#76233c,#bd6d72)}.budget-bar-warn{background:#bf8651}.budget-bar-over{background:#a83244}.budget-info,.cat-head,.day-head{display:flex;justify-content:space-between;margin-top:12rpx;color:#9b8181;font-size:23rpx}.budget-tip{margin-top:12rpx;color:#a83244;font-size:23rpx}.budget-input-row{display:flex;align-items:center}.budget-input{flex:1;padding:16rpx 22rpx;background:#f8f0eb;border:1rpx solid #ead8d3;border-radius:14rpx;font-size:29rpx}.budget-save{margin-left:16rpx;line-height:72rpx;font-size:26rpx}.cat-item{margin-bottom:20rpx}.cat-head{margin-bottom:8rpx;color:#60434a;font-size:26rpx}.cat-pct{margin-top:4rpx;color:#b29b99;font-size:21rpx;text-align:right}.day-head{padding:18rpx 0 10rpx;margin-top:14rpx;border-bottom:1rpx solid #efe3de;font-family:Georgia,"Songti SC",serif}.item{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f2e7e2}.item-icon{width:62rpx;height:62rpx;margin-right:18rpx;background:#f7ebe7;border:1rpx solid #ebd7d2;border-radius:50%;font-size:30rpx;line-height:62rpx;text-align:center}.item-body{min-width:0;flex:1}.item-title{overflow:hidden;color:#42212a;font-size:27rpx;text-overflow:ellipsis;white-space:nowrap}.item-time{margin-top:3rpx;color:#b09b99;font-size:21rpx}.item-amount{font:700 29rpx Georgia,serif}.fab{position:fixed;right:36rpx;bottom:64rpx;width:108rpx;height:108rpx;color:#fff8f3;background:linear-gradient(135deg,#54172a,#a64058);border:4rpx solid #f7e9e3;border-radius:50%;box-shadow:0 10rpx 26rpx rgba(81,20,39,.32);font:52rpx/98rpx Georgia,serif;text-align:center}

.detail-filter { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.detail-filter-btn { padding: 10rpx 20rpx; color: #76233c; background: #fff7ef; border: 1rpx solid #ead8d3; border-radius: 14rpx; font-size: 23rpx; }
.detail-filter-clear { padding: 10rpx 16rpx; color: #8c3148; font-size: 23rpx; }
