<view class="page-pad">
  <view class="intro"><view class="intro-title">小感悟</view><view class="intro-sub">把小小的体会和经验，轻轻收好</view></view>
  <view class="date-filter">
    <picker mode="date" value="{{detailDate}}" bindchange="chooseDetailDate">
      <view class="date-filter-btn">{{detailDate || '选择日期查看'}} ›</view>
    </picker>
    <view wx:if="{{detailDate}}" class="date-filter-clear" bindtap="clearDetailDate">查看全部</view>
  </view>
  <view wx:if="{{allList.length}}">
    <view wx:if="{{list.length}}">
      <view class="insight-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="editItem">
        <view class="insight-content">{{item.content}}</view>
        <view class="insight-meta">{{item.dateLabel}} {{item.time}}</view>
      </view>
    </view>
    <view wx:else class="empty">这一天没有感悟</view>
  </view>
  <view wx:elif="{{!loading}}" class="empty large-empty">还没有小感悟，写下第一条吧～</view>
  <view class="fab" bindtap="addItem">＋</view>
</view>
