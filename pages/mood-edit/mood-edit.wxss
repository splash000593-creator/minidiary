.editor{padding-top:24rpx}.moods{display:flex;justify-content:space-between;padding-bottom:26rpx;border-bottom:1rpx solid #eedfda}.mood-choice{padding:8rpx;border-radius:50%;font-size:41rpx}.mood-choice.active{background:#f1d5d4;box-shadow:inset 0 0 0 2rpx #843146;transform:scale(1.1)}.content{width:100%;min-height:270rpx;padding:27rpx 0;box-sizing:border-box;color:#41252c;font-family:Georgia,"Songti SC",serif;font-size:30rpx;line-height:1.85}.photo-grid{display:flex;flex-wrap:wrap;gap:12rpx}.photo-wrap,.add-photo{position:relative;width:calc((100vw - 136rpx)/3);height:calc((100vw - 136rpx)/3)}.photo-wrap image{width:100%;height:100%;border:1rpx solid #ebd8d3;border-radius:12rpx}.photo-remove{position:absolute;top:-11rpx;right:-11rpx;width:38rpx;height:38rpx;color:#fff;background:#6d243a;border-radius:50%;font-size:30rpx;line-height:35rpx;text-align:center}.add-photo{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#a89191;background:#f7ece7;border:1rpx dashed #cdaeb0;border-radius:12rpx;font:42rpx Georgia,serif}.add-photo text{font:20rpx -apple-system,"PingFang SC",sans-serif}.settings{padding-top:0;padding-bottom:0}.setting{display:flex;align-items:center;justify-content:space-between;padding:26rpx 0;color:#5f4249;border-bottom:1rpx solid #f0e4df}.setting:last-child{border:0}.location-row{align-items:flex-start}.location-actions{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx;max-width:500rpx}.location-name{color:#978080;font-size:23rpx;text-align:right}.loc-link{color:#853147;font-size:24rpx}.delete-link{color:#a53145}.save{width:calc(100% - 48rpx);margin:42rpx 24rpx 0}.delete{display:block;margin:32rpx auto;color:#9e3146;background:transparent;font-size:25rpx}.delete::after{border:0}
