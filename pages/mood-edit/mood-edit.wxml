<view class="page-pad editor"><view class="card"><view class="moods"><view wx:for="{{moodList}}" wx:key="*this" class="mood-choice {{moodIcon === item ? 'active' : ''}}" data-icon="{{item}}" bindtap="chooseMood">{{item}}</view></view><textarea class="content" placeholder="今天有什么想记录的吗？" maxlength="2000" auto-height value="{{content}}" bindinput="inputContent"/><view class="photo-grid"><view wx:for="{{images}}" wx:key="url" class="photo-wrap"><image src="{{item.url}}" mode="aspectFill"/><view class="photo-remove" data-index="{{index}}" bindtap="removeImage">×</view></view><view wx:if="{{images.length < 9}}" class="add-photo" bindtap="chooseImages">＋<text>照片</text></view></view></view><view class="card settings"><view class="setting"><text>日期</text><picker mode="date" value="{{date}}" bindchange="chooseDate"><view>{{date}} ›</view></picker></view><view class="setting"><text>时间</text><picker mode="time" value="{{time}}" bindchange="chooseTime"><view>{{time}} ›</view></picker></view><view class="setting location-row"><text>地点</text><view class="location-actions"><text wx:if="{{locationName}}" class="location-name">{{locationName}}</text><text class="loc-link" bindtap="chooseLocation">地图选点</text><text class="loc-link" bindtap="useCurrentLocation">自动定位</text><text wx:if="{{locationName}}" class="loc-link delete-link" bindtap="clearLocation">清除</text></view></view></view><button class="btn btn-primary btn-block save" loading="{{saving}}" bindtap="save">保存随笔</button><button wx:if="{{canDelete}}" class="delete" bindtap="remove">删除这篇随笔</button></view>
