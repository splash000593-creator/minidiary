.form{padding-top:38rpx}.type-switch{display:flex;margin:0 120rpx 34rpx;padding:5rpx;background:#eadbd6;border:1rpx solid #d6b7b6;border-radius:18rpx}.type-option{flex:1;padding:12rpx 0;color:#896d71;border-radius:14rpx;text-align:center}.selected-expense{color:#8c2941;background:#fffaf5;font-weight:700;box-shadow:0 3rpx 8rpx rgba(61,22,34,.08)}.selected-income{color:#347258;background:#fffaf5;font-weight:700;box-shadow:0 3rpx 8rpx rgba(61,22,34,.08)}.amount-panel{display:flex;align-items:center;margin:0 24rpx 24rpx;padding:42rpx 32rpx;background:linear-gradient(135deg,#fffaf6,#f6e6e2);border:1rpx solid #e5ceca;border-radius:32rpx 32rpx 18rpx 18rpx;box-shadow:0 13rpx 28rpx rgba(58,19,31,.07)}.currency{margin-right:16rpx;color:#6a2238;font:48rpx Georgia,serif}.amount-input{height:90rpx;flex:1;color:#3c1e29;font:700 64rpx Georgia,serif}.field-title{margin-bottom:22rpx;color:#3d1826;font:700 31rpx Georgia,"Songti SC",serif;letter-spacing:2rpx}.category-grid{display:grid;grid-template-columns:repeat(5,1fr);row-gap:26rpx}.category{text-align:center;color:#755c61;font-size:22rpx}.category-icon{width:76rpx;height:76rpx;margin:0 auto 6rpx;background:#f8efea;border:1rpx solid #efdfd9;border-radius:50%;font-size:36rpx;line-height:76rpx}.category-icon.chosen{background:#f2d8d6;box-shadow:inset 0 0 0 3rpx #853147}.fields{padding-top:4rpx;padding-bottom:4rpx}.field{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;color:#5e4148;border-bottom:1rpx solid #f0e5e0}.field:last-child{border:0}.note-field input{flex:1;margin-left:30rpx;color:#483039;font-size:27rpx;text-align:right}.save{width:calc(100% - 48rpx);margin:42rpx 24rpx 0}.delete{display:block;margin:32rpx auto;color:#9e3146;background:transparent;font-size:25rpx}.delete::after{border:none}
