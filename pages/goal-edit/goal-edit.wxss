.form{padding-top:38rpx}.type-switch{display:flex;margin:0 78rpx 32rpx;padding:5rpx;background:#eadbd6;border:1rpx solid #d6b7b6;border-radius:18rpx}.type{flex:1;padding:12rpx 0;color:#896d71;border-radius:14rpx;text-align:center}.type.active{color:#843147;background:#fffaf5;font-weight:700;box-shadow:0 3rpx 8rpx rgba(61,22,34,.08)}.field{display:flex;align-items:center;justify-content:space-between;padding:26rpx 0;color:#5d4048;border-bottom:1rpx solid #f0e4df}.field:last-child{border:0}.field input{max-width:430rpx;color:#442831;font-size:27rpx;text-align:right}.icon-field{align-items:flex-start}.icons{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10rpx;width:450rpx}.icon{padding:8rpx;border-radius:50%;font-size:34rpx}.icon.selected{background:#f0d5d4;box-shadow:inset 0 0 0 2rpx #843146}.tip{margin:0 30rpx;color:#9e8988;font-size:23rpx;line-height:1.8}.tip::before{content:"✦ ";color:#843146}.save{width:calc(100% - 48rpx);margin:42rpx 24rpx 0}.delete{display:block;margin:32rpx auto;color:#9e3146;background:transparent;font-size:25rpx}.delete::after{border:0}
