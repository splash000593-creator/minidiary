<view class="page-pad form"><view class="card"><view class="field"><text>目标名称</text><input placeholder="例如：每天阅读 30 分钟" data-field="title" value="{{title}}" bindinput="input"/></view><view class="field icon-field"><text>选择图标</text><view class="icons"><text wx:for="{{icons}}" wx:key="*this" data-icon="{{item}}" bindtap="chooseIcon" class="icon {{icon === item ? 'selected' : ''}}">{{item}}</text></view></view></view><view class="tip">完成打卡后目标会排到列表后面，新的一天会重新开始。</view><button class="btn btn-primary btn-block save" bindtap="save">保存目标</button><button wx:if="{{canDelete}}" class="delete" bindtap="remove">删除这个目标</button></view>