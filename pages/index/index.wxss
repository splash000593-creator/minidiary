.header { position:relative; padding:60rpx 38rpx 18rpx; }
.header::before { content:"MINIDIARY"; display:block; margin-bottom:4rpx; color:#a05767; font:20rpx Georgia,serif; letter-spacing:7rpx; }
.header::after { content:"✦  ✧  ☾"; position:absolute; right:32rpx; top:37rpx; color:#8c344c; font:25rpx Georgia,serif; letter-spacing:6rpx; }
.hello { color:#3b1625; font:700 48rpx Georgia,"Times New Roman","Songti SC",serif; letter-spacing:2rpx; }
.today { margin-top:6rpx; color:#987c7f; font-size:25rpx; letter-spacing:1rpx; }
.daily-note { display:flex; align-items:center; justify-content:center; gap:13rpx; margin:0 24rpx 20rpx; padding:13rpx 15rpx; color:#89656d; background:#fff7ef; border:1rpx solid #efdad2; border-radius:18rpx; font-size:21rpx; text-align:center; }
.daily-note-star { color:#a73e58; font:25rpx Georgia,serif; }
.record-card { margin-top:0; overflow:hidden; background:linear-gradient(135deg,#5e1930,#91364e 66%,#b26168); border-color:#713046; color:#fff9f5; }
.record-card::before { content:"✦  ☾  ✧"; right:20rpx; top:9rpx; color:rgba(255,247,239,.19); font-size:31rpx; letter-spacing:5rpx; }
.record-card-top { display:flex; align-items:center; justify-content:space-between; }
.record-kicker { color:#f1cbd0; font:19rpx Georgia,serif; letter-spacing:5rpx; }
.record-title { margin-top:6rpx; font:700 34rpx Georgia,"Songti SC",serif; }
.record-arrow { width:51rpx; height:51rpx; color:#7b2840; background:#fff7ef; border-radius:50%; font:43rpx/45rpx Georgia,serif; text-align:center; }
.record-bottom { position:relative; display:flex; align-items:baseline; margin-top:27rpx; }
.record-count { margin-right:11rpx; font:700 52rpx Georgia,serif; }
.record-text { color:#f5dfe0; font-size:23rpx; }
.record-orbit { position:absolute; right:4rpx; bottom:-28rpx; color:rgba(255,241,235,.2); font:102rpx Georgia,serif; }
.money-row { display:flex; padding-top:4rpx; }
.money-item { position:relative; flex:1; text-align:center; }
.money-item:not(:last-child)::after { content:""; position:absolute; right:0; top:13rpx; height:62rpx; width:1rpx; background:#eadbd6; }
.money-num { color:#3a2229; font:700 38rpx Georgia,serif; }
.money-label { margin-top:5rpx; color:#a58d8a; font-size:23rpx; letter-spacing:2rpx; }
.quick-row { display:flex; margin:22rpx 18rpx 26rpx; }
.quick-item { position:relative; flex:1; margin:0 6rpx; padding:23rpx 0 20rpx; overflow:hidden; color:#4b2630; text-align:center; background:rgba(255,250,246,.88); border:1rpx solid rgba(88,29,47,.14); border-radius:24rpx 24rpx 16rpx 16rpx; box-shadow:0 10rpx 22rpx rgba(54,23,33,.05); }
.quick-item::after { content:"✦"; position:absolute; top:3rpx; right:9rpx; color:#c7999d; font-size:20rpx; }
.quick-icon { font-size:43rpx; }
.quick-text { margin-top:6rpx; color:#6e4a52; font-size:23rpx; letter-spacing:1rpx; }
.card-action { color:#a05366; font:21rpx -apple-system,"PingFang SC",sans-serif; letter-spacing:0; }
.meal-item { display:flex; align-items:center; padding:13rpx 0; border-bottom:1rpx dashed #eadbd6; }
.meal-item:last-child { border-bottom:0; }
.meal-icon-wrap { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin-right:14rpx; overflow:hidden; background:#faeee8; border-radius:17rpx; }
.meal-thumb { width:100%; height:100%; }
.meal-emoji { font-size:33rpx; }
.meal-copy { min-width:0; flex:1; }
.meal-type { display:block; color:#873146; font:700 24rpx Georgia,"Songti SC",serif; }
.meal-content { display:block; overflow:hidden; margin-top:1rpx; color:#6e5b5c; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }
.meal-empty { color:#bea9a6; }
.meal-arrow { color:#ad7e88; font:34rpx/1 Georgia,serif; }
.tl-item { position:relative; display:flex; align-items:center; padding:20rpx 0; border-bottom:1rpx solid #f2e8e2; }
.tl-item:last-child { border-bottom:0; }
.tl-time { width:88rpx; color:#b29999; font:22rpx Georgia,serif; }
.tl-icon { width:58rpx; color:#71263b; font-size:31rpx; text-align:center; }
.tl-body { min-width:0; flex:1; }
.tl-title { color:#42212a; font-size:27rpx; }
.tl-desc { overflow:hidden; margin-top:2rpx; color:#a48d8b; font-size:23rpx; text-overflow:ellipsis; white-space:nowrap; }
.tl-extra { max-width:170rpx; overflow:hidden; color:#947578; font-size:25rpx; text-overflow:ellipsis; white-space:nowrap; }
