.intro{position:relative;padding:60rpx 34rpx 22rpx}.intro::before{content:"PRIVATE PAGES";display:block;margin-bottom:6rpx;color:#a25466;font:20rpx Georgia,serif;letter-spacing:6rpx}.intro::after{content:"☾";position:absolute;right:44rpx;top:40rpx;color:#6c2339;font:68rpx Georgia,serif}.intro-title{color:#3b1625;font:700 43rpx Georgia,"Songti SC",serif;letter-spacing:2rpx}.intro-sub{margin-top:7rpx;color:#9c8182;font-size:24rpx}.mood-card{position:relative;overflow:hidden;margin:22rpx 24rpx;padding:29rpx;background:rgba(255,251,247,.93);border:1rpx solid #e4cfcb;border-radius:30rpx 30rpx 18rpx 18rpx;box-shadow:0 13rpx 29rpx rgba(53,20,31,.06)}.mood-card::after{content:"✦";position:absolute;right:20rpx;bottom:12rpx;color:#d5b3b2;font:28rpx Georgia,serif}.mood-top{display:flex;align-items:center;justify-content:space-between;color:#a18b8b;font-size:22rpx}.mood-icon{margin-right:10rpx;font-size:34rpx;vertical-align:middle}.mood-date{font-family:Georgia,"Songti SC",serif}.location{max-width:270rpx;overflow:hidden;color:#946271;text-overflow:ellipsis;white-space:nowrap}.mood-content{margin-top:20rpx;color:#41252c;font-family:Georgia,"Songti SC",serif;font-size:30rpx;line-height:1.85;white-space:pre-wrap}.photos{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}.photos image{width:calc((100vw - 136rpx)/3);height:calc((100vw - 136rpx)/3);border:1rpx solid #eddcd7;border-radius:10rpx}.large-empty{padding-top:180rpx}.fab{position:fixed;right:36rpx;bottom:64rpx;width:108rpx;height:108rpx;color:#fff;background:linear-gradient(135deg,#54172a,#a64058);border:4rpx solid #f7e9e3;border-radius:50%;box-shadow:0 10rpx 26rpx rgba(81,20,39,.32);font-size:40rpx;line-height:100rpx;text-align:center}
