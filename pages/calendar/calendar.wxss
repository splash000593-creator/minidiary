.calendar-page { padding-bottom: 72rpx; }
.calendar-header { position: relative; padding: 58rpx 40rpx 23rpx; }
.calendar-header::after { content: "✦  ☾  ✧"; position: absolute; right: 31rpx; top: 45rpx; color: #9c5363; font: 28rpx Georgia, serif; letter-spacing: 6rpx; }
.calendar-kicker, .month-kicker, .day-kicker { color: #a05767; font: 20rpx Georgia, "Times New Roman", serif; letter-spacing: 4rpx; }
.calendar-title { margin-top: 4rpx; color: #3d1725; font: 700 48rpx Georgia, "Times New Roman", "Songti SC", serif; letter-spacing: 2rpx; }
.calendar-title text { color: #8f324b; font-size: 42rpx; }
.calendar-subtitle { margin-top: 5rpx; color: #967d80; font-size: 24rpx; }
.calendar-card { margin-top: 0; padding: 28rpx 20rpx 19rpx; }
.month-switcher { display: flex; align-items: center; justify-content: space-between; padding: 0 6rpx 24rpx; border-bottom: 1rpx solid #ead8d0; }
.month-center { text-align: center; }
.month-label { margin-top: 2rpx; color: #3d1826; font: 700 37rpx Georgia, "Songti SC", serif; letter-spacing: 2rpx; }
.month-arrow { display: flex; align-items: center; justify-content: center; width: 61rpx; height: 61rpx; color: #7d2941; background: #fff6ef; border: 1rpx solid #e5c8c3; border-radius: 50%; font: 45rpx/55rpx Georgia, serif; }
.month-arrow:active, .today-button:active { opacity: .78; }
.week-row, .calendar-week { display: flex; }
.week-row { margin-top: 17rpx; }
.week-name { width: 14.2857%; color: #a08285; font-size: 21rpx; text-align: center; }
.calendar-week { margin-top: 7rpx; }
.calendar-cell { box-sizing: border-box; width: 14.2857%; min-height: 76rpx; padding-top: 4rpx; border-radius: 16rpx; text-align: center; }
.calendar-cell:active { background: #f4e3dc; }
.day-number { display: inline-flex; align-items: center; justify-content: center; width: 45rpx; height: 45rpx; color: #4b2630; border-radius: 50%; font: 25rpx Georgia, "Times New Roman", serif; }
.outside-month .day-number { color: #cdbec0; }
.today-number { color: #8d2c46; font-weight: 700; box-shadow: inset 0 0 0 1rpx #b87682; }
.selected-day .day-number { color: #fff9f4; background: linear-gradient(135deg, #5a1730, #97374f); box-shadow: 0 5rpx 11rpx rgba(93, 24, 45, .2); }
.selected-day .today-number { box-shadow: 0 5rpx 11rpx rgba(93, 24, 45, .2); }
.marker-row { display: flex; justify-content: center; gap: 3rpx; height: 12rpx; margin-top: 4rpx; }
.marker, .legend-dot { display: inline-block; width: 8rpx; height: 8rpx; border-radius: 50%; }
.marker-expense { background: #aa4054; }
.marker-mood { background: #8b6eb1; }
.marker-meal { background: #d2974f; }
.marker-checkin { background: #54906d; }
.calendar-footer { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 15rpx; margin: 20rpx 7rpx 0; padding-top: 16rpx; border-top: 1rpx dashed #e4ccc6; color: #927d80; font-size: 19rpx; }
.marker-legend { display: flex; align-items: center; gap: 5rpx; }
.legend-dot { width: 9rpx; height: 9rpx; }
.today-button { margin-left: auto; padding: 5rpx 12rpx; color: #7c2941; background: #fff2eb; border-radius: 14rpx; font-size: 20rpx; }
.day-card { padding-top: 29rpx; }
.day-card-head { display: flex; align-items: flex-end; justify-content: space-between; }
.day-title { color: #3b1826; font: 700 34rpx Georgia, "Songti SC", serif; letter-spacing: 1rpx; }
.day-count { color: #873149; font: 700 44rpx Georgia, serif; }
.day-count text { margin-left: 3rpx; font-size: 20rpx; font-weight: 400; }
.day-record-text { margin: 13rpx 0 16rpx; padding: 9rpx 13rpx; color: #8d6f74; background: #fff7ef; border-radius: 14rpx; font-size: 22rpx; }
.tl-item { display: flex; align-items: center; min-height: 86rpx; border-top: 1rpx solid #f0e1da; }
.tl-time { width: 74rpx; color: #a58d8e; font: 20rpx Georgia, serif; }
.tl-icon { display: flex; align-items: center; justify-content: center; width: 45rpx; height: 45rpx; margin-right: 13rpx; color: #74283e; background: #fff1eb; border-radius: 50%; font-size: 23rpx; }
.tl-body { flex: 1; min-width: 0; }
.tl-title { color: #47212d; font-size: 25rpx; font-weight: 600; }
.tl-desc { overflow: hidden; color: #9a8586; font-size: 21rpx; white-space: nowrap; text-overflow: ellipsis; }
.tl-extra { max-width: 140rpx; margin-left: 10rpx; overflow: hidden; color: #927a7d; font-size: 20rpx; white-space: nowrap; text-overflow: ellipsis; }
.calendar-empty { padding: 31rpx 0 19rpx; }

.tl-section { margin-top: 14rpx; }
.tl-section-head { padding: 8rpx 0 4rpx; color: #8f324b; font: 700 24rpx Georgia, "Songti SC", serif; letter-spacing: 2rpx; }
